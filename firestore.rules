// vision 0.2
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin = el documento usuarios/{uid} tiene tipo 'administrador'.
    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipo == 'administrador';
    }

    match /usuarios/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());

      // Solo puede crear SU documento y siempre como jugador.
      allow create: if isAuthenticated()
        && request.auth.uid == uid
        && request.resource.data.tipo == 'jugador';

      // El dueño edita su perfil pero no puede cambiar su tipo.
      allow update: if isAdmin()
        || (isAuthenticated() && request.auth.uid == uid
            && request.resource.data.tipo == resource.data.tipo);

      allow delete: if isAdmin();
    }

    match /experiences/{id_experiencia} {
      allow read: if resource.data.activa == true || isAdmin();
      allow create, update, delete: if isAdmin();

      match /desafios/{id_desafio} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();

        match /secreto/respuesta {
          allow read, write: if isAdmin();
        }
      }
    }

    match /participaciones/{id_participacion} {
      // El jugador necesita leer la suya (restaurar progreso); el admin lee todas.
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.usuarioId == request.auth.uid);

      allow create: if isAuthenticated()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.estado == 'en_curso';

      allow update: if isAdmin()
        || (isAuthenticated()
            && resource.data.usuarioId == request.auth.uid
            && request.resource.data.usuarioId == resource.data.usuarioId);
    }

    match /elementos_fisicos/{id} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
  }
}